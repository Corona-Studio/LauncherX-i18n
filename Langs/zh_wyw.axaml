  <sys:String x:Key="GameLaunchTargets">游戏启动目标</sys:String>
  <sys:String x:Key="DefaultGameTarget">此游戏的默认启动目标</sys:String>
  <sys:String x:Key="InheritGlobalServer">使用全局服务器设置</sys:String>
  <sys:String x:Key="GameTitleScreen">进入标题画面</sys:String>
  <sys:String x:Key="GameServerTarget">进入固定的服务器</sys:String>
  <sys:String x:Key="GameWorldTarget">进入固定的世界</sys:String>
  <sys:String x:Key="GameServers">此游戏的服务器</sys:String>
  <sys:String x:Key="GameServersHint">可编辑服务器名称和地址；保存设置后写入此游戏的服务器列表。</sys:String>
  <sys:String x:Key="AddGameServer">添加服务器</sys:String>
  <sys:String x:Key="RemoveGameServer">移除服务器</sys:String>
  <sys:String x:Key="ImportGlobalServers">复制全局服务器</sys:String>
  <sys:String x:Key="PinLaunchTarget">设为默认启动目标</sys:String>
  <sys:String x:Key="UseZinkRenderer">使用 Zink（Vulkan）</sys:String>
  <sys:String x:Key="ZinkRendererHint">需要支持 Zink 的 Mesa 和兼容的 Vulkan 驱动，仅对此游戏生效。</sys:String>
  <sys:String x:Key="WorldQuickPlayHint">选择存档目录。直接进入世界需要 Minecraft 1.20 或声明支持快速启动的版本；默认目标也用于主页启动。</sys:String>
  <sys:String x:Key="WorldQuickPlayUnavailable">此游戏版本不支持直接进入世界。</sys:String>
  <sys:String x:Key="GamePathChangedReload">游戏路径已切换，请重新打开此游戏的设置。</sys:String>
  <sys:String x:Key="LxGameSettingsHint">此游戏的设置由 LauncherX 管理，已有启动配置会自动迁移。</sys:String>
  <sys:String x:Key="PerGameInheritHint">留空表示使用全局设置，内存单位为 MB。</sys:String>
  <sys:String x:Key="PerGameInherit">使用全局设置</sys:String>
  <sys:String x:Key="MinimumGameMemory">最小内存（MB）</sys:String>
  <sys:String x:Key="PerGameGarbageCollector">垃圾回收器</sys:String>
  <sys:String x:Key="PerGameDefaultGc">Java 默认</sys:String>
  <sys:String x:Key="PerGameGcHint">请选择当前 Java 支持的回收器，旧回收器可能不适用于新版 Java。</sys:String>
  <sys:String x:Key="PerGameJvmArguments">附加 JVM 参数</sys:String>
  <sys:String x:Key="PerGameWindowWidth">窗口宽度</sys:String>
  <sys:String x:Key="PerGameWindowHeight">窗口高度</sys:String>
  <sys:String x:Key="PerGameTristateHint">横线表示使用全局设置，勾选表示启用，未勾选表示关闭。</sys:String>
  <sys:String x:Key="PerGameAdvancedSettings">此游戏的高级设置</sys:String>
  <sys:String x:Key="PerGameGameArguments">附加游戏参数</sys:String>
  <sys:String x:Key="PerGameArgumentsHint">输入命令行参数，包含空格的值使用引号包围；JVM 参数与游戏参数分别设置。</sys:String>
  <sys:String x:Key="PerGameEnvironment">环境变量</sys:String>
  <sys:String x:Key="PerGameEnvironmentHint">每行一个 NAME=value，此游戏的值会覆盖全局及 GAME_ENV 中的同名变量。</sys:String>
  <sys:String x:Key="ResetPerGameOverrides">将覆盖项重置为全局设置</sys:String>
</ResourceDictionary>
