  <sys:String x:Key="PerformingUpdate">Actualización en progreso</sys:String>
  <sys:String x:Key="PerformingUpdateDetail">LauncherX se está actualizando ahora, espere un momento.</sys:String>
  <sys:String x:Key="FailedToExtractLauncherIcon">No se puede descomprimir el ícono de notificación</sys:String>
  <sys:String x:Key="FailedToExtractLauncherIconDetail">LauncherX no tiene un ícono de notificación de descompresión exitosa. Esto no afectará el uso normal del iniciador, pero puede causar que las notificaciones del sistema no tengan íconos.</sys:String>
  <!-- 统一补充的界面与运行时本地化 -->
  <sys:String x:Key="ConnectXRuntimeMissing">El componente principal de ConnectX en el que se basa la funcionalidad multijugador está deshabilitado debido a que faltan bibliotecas de tiempo de ejecución, posiblemente VC++ Runtime. Instale la biblioteca en tiempo de ejecución y reinicie el iniciador antes de volver a intentarlo.</sys:String>
  <sys:String x:Key="LaunchInDebugMode">Iniciar en modo de depuración</sys:String>
  <sys:String x:Key="Use2DAccountAvatar">Mostrar avatar de cuenta en modo 2D</sys:String>
