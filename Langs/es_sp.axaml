  <sys:String x:Key="ThanksInfoApiServer">Gracias a Gen123 por proporcionar el servidor que aloja la API de información.</sys:String>
  <sys:String x:Key="ThanksSpecialSponsorship">Gracias a Dragon Sauce Sama por brindar patrocinio especial y pruebas adicionales.</sys:String>
  <sys:String x:Key="ThanksAccelerationService">Gracias a Milkshake por brindar servicios de aceleración y soluciones de red.</sys:String>
  <sys:String x:Key="SearchAmongGames">Buscar juegos {0}</sys:String>
